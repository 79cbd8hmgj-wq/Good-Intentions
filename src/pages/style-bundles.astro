---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteData from "../../content/site.json";
const service = siteData.services.styleBundles;
---
<BaseLayout title="Style bundles" description="Tell Sage what you are into and let her build a secondhand style bundle around you.">
  <section class="page-hero">
    <span class="eyebrow">Tell Sage the vibe</span>
    <h1>Style bundles</h1>
    <p>{service.summary}</p>
    <a class="button button-primary" href={siteData.business.instagram} target="_blank" rel="noreferrer">Message Sage on Instagram</a>
  </section>
  <section class="page-section feature-grid">
    <div class="feature-art"><span>Made<br />for you</span></div>
    <div class="feature-copy">
      <h2>How it works</h2>
      <ol class="process-list">{service.process.map((step) => <li>{step}</li>)}</ol>
      <div class="checkout-note">
        <strong>Bundles have started at ${service.startingPrice}</strong>
        <p>That has covered a small bundle in the past. Sage will confirm the current price, number of pieces, and timing with you before she starts looking.</p>
      </div>
    </div>
  </section>
</BaseLayout>
