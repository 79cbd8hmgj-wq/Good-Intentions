---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteData from "../../content/site.json";

const featuredProducts = siteData.products.slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">2000s · hipster · good vibes · free-spirited</span>
      <h1>Curated pieces.<br /><em>Good Intentions.</em></h1>
      <p>{siteData.business.description}</p>
      <div class="button-row">
        <a class="button button-primary" href="/shop">Shop new arrivals</a>
        <a class="button button-secondary" href="/style-bundles">Explore style bundles</a>
      </div>
    </div>
    <div class="hero-art" aria-label="Good Intentions collection preview">
      <div class="hero-card hero-card-a"><strong>Shakira<br />Collection</strong></div>
      <div class="hero-card hero-card-b"><strong>A Midsummer<br />Night's Dream</strong></div>
      <div class="hero-card hero-card-c"><strong>Zara Larsson</strong></div>
      <span class="hero-orb" aria-hidden="true"></span>
    </div>
  </section>

  <section class="value-strip" aria-label="Good Intentions values">
    <article><b>One-of-one</b><p>Unique secondhand pieces</p></article>
    <article><b>Curated with intention</b><p>Handpicked by Sage</p></article>
    <article><b>Community first</b><p>Markets, music, and good vibes</p></article>
    <article><b>Expressive style</b><p>More than one aesthetic</p></article>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <div><h2>Themed collections</h2><p>Music, mood, nostalgia, and personal style shape each collection.</p></div>
      <a class="text-link" href="/shop">Browse the shop →</a>
    </div>
    <div class="collection-grid">
      {siteData.collections.slice(0, 3).map((collection) => (
        <article class:list={["collection-card", `palette-${collection.palette}`]}>
          <div><span class="eyebrow">Collection archive</span><h3>{collection.name}</h3><p>{collection.description}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <div><h2>Shop foundation</h2><p>Example listings interpreted from the supplied Instagram references. Real measurements and availability are still required.</p></div>
      <a class="text-link" href="/shop">View catalog →</a>
    </div>
    <div class="product-grid">
      {featuredProducts.map((product) => (
        <a class="product-card" href={`/shop/${product.slug}`}>
          <div class="product-visual"><span>{product.name}</span></div>
          <div class="product-meta">
            <div><h3>{product.name}</h3><p>{product.category} · {product.size}</p></div>
            <strong>${product.price}</strong>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section feature-grid">
    <div class="feature-art"><span>Style<br />bundles</span></div>
    <div class="feature-copy">
      <span class="eyebrow">Personal curation</span>
      <h2>Built through real conversation.</h2>
      <p>{siteData.services.styleBundles.summary}</p>
      <ol class="process-list">
        {siteData.services.styleBundles.process.slice(0, 3).map((step) => <li>{step}</li>)}
      </ol>
      <a class="button button-primary" href="/style-bundles">How bundles work</a>
    </div>
  </section>
</BaseLayout>
