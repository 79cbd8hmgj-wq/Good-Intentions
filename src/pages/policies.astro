---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteData from "../../content/site.json";

const policies = [
  ["Shipping", siteData.policies.shipping],
  ["Returns and exchanges", siteData.policies.returns],
  ["One-of-one inventory", siteData.policies.oneOfOne],
  ["Secondhand condition", siteData.policies.condition],
  ["Style bundles and styling", siteData.policies.customServices],
  ["Donations", siteData.policies.donations],
];
---
<BaseLayout title="Policies" description="Draft Good Intentions store, shipping, styling, and donation policies." noindex>
  <section class="page-hero">
    <span class="eyebrow">Draft for Sage's approval</span>
    <h1>Policies</h1>
    <p>These policies establish the structure needed for direct checkout. They remain private from search engines and must be finalized before sales are enabled.</p>
  </section>
  <section class="page-section policy-list">
    {policies.map(([label, value]) => (
      <article class="policy-card"><h2>{label}</h2><p>{value}</p></article>
    ))}
  </section>
</BaseLayout>
