---
import BaseLayout from "../../layouts/BaseLayout.astro";
import siteData from "../../../content/site.json";

export function getStaticPaths() {
  return siteData.products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const canCheckout = siteData.commerce.checkoutEnabled && product.status === "available" && Boolean(product.checkoutUrl);
const checkoutHref = product.checkoutUrl ?? "#";
const isDraft = product.status === "draft";
const pageDescription = isDraft
  ? `Preview listing for ${product.name} from Good Intentions. Final photos and product details are still being prepared.`
  : `${product.name} from Good Intentions. ${product.condition}`;
---
<BaseLayout title={product.name} description={pageDescription} noindex={isDraft}>
  <section class="page-section detail-shell">
    <div class="detail-art"><span>{isDraft ? "Photo coming soon" : product.name}</span></div>
    <div class="detail-copy">
      <a class="text-link" href="/shop">← Back to shop</a>
      <span class="eyebrow">{product.category}</span>
      <h1>{product.name}</h1>
      {isDraft ? <p><strong>Preview listing</strong></p> : <p><strong>${product.price}</strong></p>}
      <dl class="spec-list">
        <div><dt>Size</dt><dd>{product.size}</dd></div>
        <div><dt>Measurements</dt><dd>{product.measurements}</dd></div>
        <div><dt>Brand</dt><dd>{product.brand}</dd></div>
        <div><dt>Condition</dt><dd>{product.condition}</dd></div>
        <div><dt>Material</dt><dd>{product.material}</dd></div>
        <div><dt>Color</dt><dd>{product.color}</dd></div>
        <div><dt>Quantity</dt><dd>{product.quantity}</dd></div>
      </dl>
      {canCheckout ? (
        <a class="button button-primary" href={checkoutHref}>Buy securely</a>
      ) : (
        <button class="button button-disabled" type="button" disabled>Not available to buy yet</button>
      )}
      <p class="checkout-note">This page is holding the place for the real listing. Sage still needs to add the original photos, exact measurements, condition notes, shipping weight, final price, and purchase link.</p>
    </div>
  </section>
</BaseLayout>
