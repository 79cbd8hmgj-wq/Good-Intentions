---
import BaseLayout from "../../layouts/BaseLayout.astro";
import siteData from "../../../content/site.json";

export function getStaticPaths() {
  return siteData.products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const canCheckout = siteData.commerce.checkoutEnabled && product.status === "available" && Boolean(product.checkoutUrl);
const checkoutHref = product.checkoutUrl ?? "#";
---
<BaseLayout title={product.name} description={`${product.name} from Good Intentions. ${product.condition}`}>
  <section class="page-section detail-shell">
    <div class="detail-art"><span>{product.name}</span></div>
    <div class="detail-copy">
      <a class="text-link" href="/shop">← Back to shop</a>
      <span class="eyebrow">{product.category}</span>
      <h1>{product.name}</h1>
      <p><strong>${product.price}</strong></p>
      <dl class="spec-list">
        <div><dt>Size</dt><dd>{product.size}</dd></div>
        <div><dt>Measurements</dt><dd>{product.measurements}</dd></div>
        <div><dt>Brand</dt><dd>{product.brand}</dd></div>
        <div><dt>Condition</dt><dd>{product.condition}</dd></div>
        <div><dt>Material</dt><dd>{product.material}</dd></div>
        <div><dt>Color</dt><dd>{product.color}</dd></div>
        <div><dt>Quantity</dt><dd>{product.quantity}</dd></div>
      </dl>
      {canCheckout ? (
        <a class="button button-primary" href={checkoutHref}>Buy securely</a>
      ) : (
        <button class="button button-disabled" type="button" disabled>Checkout coming soon</button>
      )}
      <p class="checkout-note">Foundation listing only. Real photos, measurements, condition notes, shipping weight, availability, and a secure payment link must be confirmed before sale.</p>
    </div>
  </section>
</BaseLayout>
