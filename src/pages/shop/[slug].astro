---
import BaseLayout from "../../layouts/BaseLayout.astro";
import siteData from "../../../content/site.json";

export function getStaticPaths() {
  return siteData.products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const isDraft = product.status === "draft";
const canCheckout = siteData.commerce.checkoutEnabled && product.status === "available" && product.quantity === 1;
const pageDescription = isDraft
  ? `Preview listing for ${product.name} from Good Intentions. Final photos and product details are still being prepared.`
  : `${product.name} from Good Intentions. ${product.condition}`;
---
<BaseLayout title={product.name} description={pageDescription} noindex={isDraft}>
  <section class="page-section detail-shell">
    <div class="detail-art"><span>{isDraft ? "Photo coming soon" : product.name}</span></div>
    <div class="detail-copy">
      <a class="text-link" href="/shop">← Back to shop</a>
      <span class="eyebrow">{product.category}</span>
      <h1>{product.name}</h1>
      {isDraft ? <p><strong>Preview listing</strong></p> : <p class="product-price"><strong>${product.price}</strong></p>}
      <dl class="spec-list">
        <div><dt>Size</dt><dd>{product.size}</dd></div>
        <div><dt>Measurements</dt><dd>{product.measurements}</dd></div>
        <div><dt>Brand</dt><dd>{product.brand}</dd></div>
        <div><dt>Condition</dt><dd>{product.condition}</dd></div>
        <div><dt>Material</dt><dd>{product.material}</dd></div>
        <div><dt>Color</dt><dd>{product.color}</dd></div>
        <div><dt>Quantity</dt><dd>{product.quantity}</dd></div>
      </dl>
      {canCheckout ? (
        <form class="checkout-form" method="post" action="/api/checkout">
          <input type="hidden" name="productSlug" value={product.slug} />
          <button class="button button-primary checkout-button" type="submit">Continue to secure checkout</button>
          <p>Payment and card details are collected on Stripe's secure checkout page. Website orders ship within the United States.</p>
        </form>
      ) : (
        <div class="checkout-disabled-panel">
          <button class="button button-disabled" type="button" disabled>Not available to buy yet</button>
          <p>Checkout stays locked until Sage confirms the item, price, measurements, shipping details, and store policies.</p>
        </div>
      )}
      {isDraft && <p class="checkout-note">This page is holding the place for the real listing. Sage still needs to add the original photos, exact measurements, condition notes, shipping weight, and final price.</p>}
    </div>
  </section>
</BaseLayout>
