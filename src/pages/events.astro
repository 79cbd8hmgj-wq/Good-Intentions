---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteData from "../../content/site.json";
---
<BaseLayout title="Events" description="Find Good Intentions at vintage markets and community pop-ups.">
  <section class="page-hero">
    <span class="eyebrow">Shop the racks in person</span>
    <h1>Markets and pop-ups</h1>
    <p>{siteData.events.summary} Online orders ship, but events are where you can see the clothes up close, try things on, and talk with Sage.</p>
  </section>
  <section class="page-section">
    <article class="event-card">
      <div class="event-art"><span>See you<br />out there</span></div>
      <div class="event-copy">
        <span class="eyebrow">New dates coming soon</span>
        <h2>The next rack is being packed.</h2>
        <p>Sage regularly brings Good Intentions to vintage markets, neighborhood pop-ups, and community events around the Capital Region and nearby.</p>
        <p>Until the website calendar is filled in, Instagram is the best place to catch the newest date, location, and event flyer.</p>
        <a class="button button-primary" href={siteData.business.instagram} target="_blank" rel="noreferrer">Check current event dates</a>
      </div>
    </article>
  </section>
</BaseLayout>
