---
import siteData from "../../content/site.json";
import "../styles/global.css";
import "../styles/checkout.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const {
  title = siteData.business.name,
  description = siteData.business.description,
  path = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const fullTitle = title === siteData.business.name ? title : `${title} | ${siteData.business.name}`;
const canonical = new URL(path, Astro.site ?? Astro.url);
const nav = [
  ["Shop", "/shop"],
  ["Style bundles", "/style-bundles"],
  ["Personal styling", "/personal-styling"],
  ["Events", "/events"],
  ["Donate", "/donate"],
  ["About", "/about"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#160e16" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!siteData.commerce.checkoutEnabled && <div class="development-banner">Website preview — the online shop is not open yet.</div>}
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="/" aria-label="Good Intentions home">
          <span class="brand-orb" aria-hidden="true"></span>
          <span>good<br />Intentions</span>
        </a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation">
          <span></span><span></span><span></span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
          {nav.map(([label, href]) => (
            <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-shell">
        <div class="footer-intro">
          <a class="brand brand-small" href="/"><span class="brand-orb" aria-hidden="true"></span><span>good<br />Intentions</span></a>
          <div>
            <p>One-of-one secondhand clothing, themed collections, and personal styling by Sage.</p>
            <span>{siteData.commerce.shipping}</span>
          </div>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/shop">Shop</a>
          <a href="/style-bundles">Style bundles</a>
          <a href="/personal-styling">Personal styling</a>
          <a href="/events">Events</a>
          <a href="/donate">Donate</a>
          <a href="/about">About</a>
          <a href="/policies">Policies</a>
        </nav>
        <div class="footer-follow">
          <span>Follow the newest finds</span>
          <a href={siteData.business.instagram} target="_blank" rel="noreferrer">Instagram ↗</a>
          <a href={siteData.business.depop} target="_blank" rel="noreferrer">Depop ↗</a>
        </div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Good Intentions</span><span>Picked and styled by Sage</span></div>
    </footer>
    <script is:inline>
      const button = document.querySelector('.menu-button');
      const nav = document.querySelector('#site-nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        button.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
        nav?.classList.toggle('is-open', !open);
      });
    </script>
  </body>
</html>
